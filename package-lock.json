{
  "name": "ctxvigil-workspace",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "ctxvigil-workspace",
      "version": "0.1.0",
      "license": "MIT",
      "workspaces": [
        "packages/*",
        "apps/*"
      ],
      "engines": {
        "node": ">=22.18.0"
      }
    },
    "apps/protection-api": {
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "ctxvigil": "*"
      },
      "engines": {
        "node": ">=22.18.0"
      }
    },
    "node_modules/@ctxvigil/shared-types": {
      "resolved": "packages/shared-types",
      "link": true
    },
    "node_modules/ctxvigil": {
      "resolved": "packages/ctxvigil-core",
      "link": true
    },
    "node_modules/ctxvigil-cli": {
      "resolved": "packages/ctxvigil-cli",
      "link": true
    },
    "node_modules/protection-api": {
      "resolved": "apps/protection-api",
      "link": true
    },
    "packages/ctxvigil-cli": {
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "ctxvigil": "*"
      },
      "bin": {
        "ctxvigil": "src/index.ts"
      },
      "engines": {
        "node": ">=22.18.0"
      }
    },
    "packages/ctxvigil-core": {
      "name": "ctxvigil",
      "version": "0.1.0",
      "license": "MIT",
      "engines": {
        "node": ">=22.18.0"
      }
    },
    "packages/shared-types": {
      "name": "@ctxvigil/shared-types",
      "version": "0.1.0",
      "license": "MIT"
    }
  }
}
