{
  "$comment": "Normative expected outcomes for the seven contract test IDs (S2 A3.8). Field names in scan responses are frozen by docs/03_API_CONTRACT.md; the assertions below are the test oracle.",
  "version": 1,
  "tests": [
    {
      "testId": "safe-refund-page",
      "scanRequest": "scan-requests/safe-refund-page.json",
      "expect": {
        "riskLevel": ["low"],
        "riskScoreMax": 29,
        "decision": ["allow"],
        "findingsExpected": "none_high_severity",
        "blockedContentEmpty": true
      }
    },
    {
      "testId": "visible-injection",
      "scanRequest": "scan-requests/visible-injection.json",
      "actionRequest": null,
      "expect": {
        "riskLevel": ["high", "critical"],
        "riskScoreMin": 60,
        "decision": ["sanitize", "confirm", "block"],
        "requiredSignals": ["instruction_override"],
        "requiredViews": ["visible_text"],
        "blockedContentNonEmpty": true
      }
    },
    {
      "testId": "hidden-dom-injection",
      "scanRequest": "scan-requests/hidden-dom-injection.json",
      "actionRequest": null,
      "expect": {
        "riskLevel": ["high", "critical"],
        "riskScoreMin": 60,
        "decision": ["sanitize", "confirm", "block"],
        "requiredSignals": ["hidden_content"],
        "requiredViews": ["hidden_dom"],
        "blockedContentNonEmpty": true
      }
    },
    {
      "testId": "aria-injection",
      "scanRequest": "scan-requests/aria-injection.json",
      "actionRequest": "action-checks/aria-injection-change-email.json",
      "expect": {
        "riskLevel": ["high", "critical"],
        "riskScoreMin": 60,
        "decision": ["confirm", "block"],
        "requiredSignals": ["instruction_override", "hidden_content", "task_conflict", "risky_action"],
        "requiredViews": ["accessibility_tree"],
        "blockedContentNonEmpty": true,
        "actionDecision": ["block"],
        "actionAllowed": false,
        "actionConfirmationRequired": false
      }
    },
    {
      "testId": "benign-aria-label",
      "scanRequest": "scan-requests/benign-aria-label.json",
      "actionRequest": "action-checks/benign-aria-label-submit.json",
      "expect": {
        "riskScoreMax": 59,
        "decision": ["allow", "sanitize"],
        "mustNotBlockSolelyForImperativeAccessibleLabel": true,
        "actionDecision": ["allow", "confirm"]
      }
    },
    {
      "testId": "unrelated-account-action",
      "scanRequest": "scan-requests/unrelated-account-action.json",
      "actionRequest": "action-checks/unrelated-account-action-change-email.json",
      "expect": {
        "actionDecision": ["block"],
        "actionAllowed": false,
        "actionConfirmationRequired": false,
        "reasonNonEmpty": true
      }
    },
    {
      "testId": "task-aligned-summary-action",
      "scanRequest": "scan-requests/task-aligned-summary-action.json",
      "actionRequest": "action-checks/task-aligned-summary-action-summarize.json",
      "expect": {
        "riskLevel": ["low"],
        "decision": ["allow"],
        "actionDecision": ["allow"],
        "actionAllowed": true,
        "actionConfirmationRequired": false
      }
    }
  ]
}
