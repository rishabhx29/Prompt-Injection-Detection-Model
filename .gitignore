# ============================================================
# Agent / authoring tooling
# ============================================================

# Tracked on purpose: `.agents/`, `.claude/` and `agent/` hold the
# skill libraries + instructions, and `AGENTS.md` / `CLAUDE.md` /
# `skills-lock.json` pin them. Keep those in the repo.

# Local-only orchestrator workspace (never published)
/agents_orchestrator/
/.freebuff/

# ============================================================
# Dependencies
# ============================================================
node_modules/
.venv/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
.eggs/
*.so
.pdm-python

# ============================================================
# Build / pack output
# ============================================================
dist/
build/
packages/*/dist/
*.tsbuildinfo

# npm pack / publish artifacts
*.tgz

# ============================================================
# Test & evaluation output
# ============================================================
tests/results/
packages/*/tests/results/
coverage/
*.log
npm-debug.log*

# ============================================================
# Environment & secrets
# ============================================================
.env
.env.*
!.env.example

# ============================================================
# Data & generated artefacts
# ============================================================
/data/raw/
graphify-out/
eval_ml/eval_ml/

# Model weights (exceed GitHub 100 MB cap; available via Colab/Kaggle)
*.pt

# Local duplicate downloads
*(1)*
*(2)*

