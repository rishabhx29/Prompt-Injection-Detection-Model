{
  "name": "demo-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --no-node-snapshot ./node_modules/vite/bin/vite.js",
    "build": "node --no-node-snapshot ./node_modules/typescript/bin/tsc --project tsconfig.app.json && node --no-node-snapshot ./node_modules/vite/bin/vite.js build",
    "preview": "node --no-node-snapshot ./node_modules/vite/bin/vite.js preview",
    "verify:phase1": "node scripts/verify-phase1.mjs",
    "verify:phase2": "node scripts/verify-phase2.mjs",
    "verify:phase3": "node scripts/verify-phase3.mjs",
    "verify:phase4": "node scripts/verify-phase4.mjs",
    "verify:phase5": "node scripts/verify-phase5.mjs",
    "verify:phase6": "node scripts/verify-phase6.mjs",
    "verify:contract": "node scripts/verify-integration-contract.mjs",
    "verify:all": "node scripts/verify-all.mjs"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
